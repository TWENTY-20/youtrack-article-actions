{
  "name": "youtrack-article-actions",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json && vite build && vite build --mode workflows && youtrack-app validate build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf archive_name.zip && npx --yes bestzip archive_name.zip build/*",
    "upload": "youtrack-app upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.23.0",
    "@jetbrains/ring-ui-built": "^7.0.116",
    "core-js": "^3.49.0",
    "i18next": "^26.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jetbrains/eslint-config": "^6.0.5",
    "@jetbrains/youtrack-apps-tools": "^0.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
