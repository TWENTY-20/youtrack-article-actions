{
  "name": "youtrack-article-actions",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json && vite build && vite build --mode workflows && youtrack-app validate build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf archive_name.zip && npx --yes bestzip archive_name.zip build/*",
    "upload": "youtrack-app upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.15.0",
    "@jetbrains/ring-ui-built": "^7.0.85",
    "core-js": "^3.47.0",
    "i18next": "^25.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@jetbrains/eslint-config": "^6.0.5",
    "@jetbrains/youtrack-apps-tools": "^0.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
