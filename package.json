{
  "name": "youtrack-article-actions",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json && vite build && vite build --mode workflows && youtrack-app validate build",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "pack": "rm -rf archive_name.zip && npx --yes bestzip archive_name.zip build/*",
    "upload": "youtrack-app upload build"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.11.0",
    "@jetbrains/ring-ui-built": "^7.0.57",
    "core-js": "3.44.0",
    "i18next": "^25.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@jetbrains/eslint-config": "^6.0.5",
    "@jetbrains/youtrack-apps-tools": "^0.0.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vite-plugin-static-copy": "^3.1.1"
  }
}
