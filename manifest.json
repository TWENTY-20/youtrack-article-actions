{
  "$schema": "https://json.schemastore.org/youtrack-app.json",
  "name": "youtrack-article-actions",
  "title": "YouTrack Article Actions",
  "description": "Copy or move an article in the Knowledge Base",
  "changeNotes": "See https://plugins.jetbrains.com/plugin/25371-youtrack-article-actions/release-notes",
  "version": "1.0.5",
  "vendor": {
    "name": "twenty20",
    "url": "https://twenty20.de"
  },
  "icon": "icon.png",
  "minYouTrackVersion": "2025.1.0",
  "widgets": [
    {
      "key": "article-menu-demo",
      "name": "Copy or Move",
      "indexPath": "copy-or-move/index.html",
      "extensionPoint": "ARTICLE_OPTIONS_MENU_ITEM",
      "expectedDimensions": {
        "width": 360,
        "height": 330
      },
      "permissions": ["CREATE_ARTICLE", "UPDATE_ARTICLE"]
    }
  ]
}
